{
  "entries": [
    {
      "id": "daicowtf-root-html-range",
      "description": "ENS-resolved daicowtf.eth root CID. Root UnixFS file must render as HTML, not octet-stream.",
      "path": "/ipfs/QmWWbDw6kriAjRLyJNaeXjqqoyNn6kA18C42ubVzYKS4wS/",
      "range": "bytes=0-256",
      "expect_status": 206,
      "expect_content_type_prefix": "text/html",
      "expect_content_range_prefix": "bytes 0-256/",
      "expect_body_contains": "<!DOCTYPE html",
      "min_bytes": 257,
      "max_ttfb_ms": 30000
    },
    {
      "id": "daicowtf-page-assets",
      "description": "Fetch daicowtf.eth root HTML and same-origin browser subresources using app-style ipfs:// path semantics.",
      "path": "/ipfs/QmWWbDw6kriAjRLyJNaeXjqqoyNn6kA18C42ubVzYKS4wS/",
      "expect_status": 200,
      "expect_content_type_prefix": "text/html",
      "expect_body_contains": "<!DOCTYPE html",
      "min_bytes": 100000,
      "max_ttfb_ms": 30000,
      "crawl": {
        "max_assets": 32,
        "min_assets": 0,
        "max_failed_assets": 0,
        "same_origin_only": true,
        "include_css_assets": true,
        "asset_max_bytes": 2000000
      }
    },
    {
      "id": "vitalik-root-html-range",
      "description": "ENS-resolved immutable vitalik.eth home snapshot. Adds a second CID-only HTML/range shape outside the DAICO page.",
      "path": "/ipfs/bafybeiaql2jo3fu5b7c4lmpoi5drh5sam7yt652shwdgwbky4o7uw33u2u",
      "range": "bytes=0-127",
      "expect_status": 206,
      "expect_content_type_prefix": "text/html",
      "expect_content_range_prefix": "bytes 0-127/",
      "min_bytes": 128,
      "max_ttfb_ms": 30000
    },
    {
      "id": "ipfs-tech-root-html-range",
      "description": "DNSLink-backed IPNS website root. Exercises name resolution plus HTML gateway serving.",
      "path": "/ipns/ipfs.tech/",
      "range": "bytes=0-4095",
      "expect_status": 206,
      "expect_content_type_prefix": "text/html",
      "expect_content_range_prefix": "bytes 0-4095/",
      "expect_body_contains": "<title>IPFS",
      "min_bytes": 4096,
      "max_ttfb_ms": 45000
    },
    {
      "id": "ipfs-tech-page-assets",
      "description": "Fetch ipfs.tech root HTML and same-origin browser subresources using app-style ipns:// path semantics.",
      "path": "/ipns/ipfs.tech/",
      "expect_status": 200,
      "expect_content_type_prefix": "text/html",
      "expect_body_contains": "<title>IPFS",
      "min_bytes": 100000,
      "max_ttfb_ms": 45000,
      "crawl": {
        "max_assets": 32,
        "min_assets": 8,
        "max_failed_assets": 0,
        "same_origin_only": true,
        "include_css_assets": true,
        "asset_max_bytes": 2000000
      }
    },
    {
      "id": "ipfs-tech-developers-hero-range",
      "description": "DNSLink-backed image range from the ipfs.tech page bundle. Exercises media byte ranges without fetching the full image.",
      "path": "/ipns/ipfs.tech/_nuxt/developers-hero.BRuJDQyf.jpg",
      "range": "bytes=0-4095",
      "expect_status": 206,
      "expect_content_type_prefix": "image/",
      "expect_content_range_prefix": "bytes 0-4095/",
      "expect_content_length_min": 4096,
      "min_bytes": 4096,
      "max_ttfb_ms": 45000
    },
    {
      "id": "ipfs-tech-developers-hero-middle-range",
      "description": "DNSLink-backed image middle byte range from the ipfs.tech page bundle. Exercises non-zero media seek behavior.",
      "path": "/ipns/ipfs.tech/_nuxt/developers-hero.BRuJDQyf.jpg",
      "range": "bytes=4096-8191",
      "expect_status": 206,
      "expect_content_type_prefix": "image/",
      "expect_content_range_prefix": "bytes 4096-8191/",
      "expect_content_length_min": 4096,
      "min_bytes": 4096,
      "max_ttfb_ms": 45000
    },
    {
      "id": "ipfs-tech-developers-hero-suffix-range",
      "description": "DNSLink-backed image suffix byte range from the ipfs.tech page bundle. Exercises browser-style tail range reads.",
      "path": "/ipns/ipfs.tech/_nuxt/developers-hero.BRuJDQyf.jpg",
      "range": "bytes=-4096",
      "expect_status": 206,
      "expect_content_type_prefix": "image/",
      "expect_content_range_prefix": "bytes ",
      "expect_content_length_min": 4096,
      "min_bytes": 4096,
      "max_ttfb_ms": 45000
    },
    {
      "id": "ipfs-tech-developers-hero-head",
      "description": "DNSLink-backed image HEAD request from the ipfs.tech page bundle. Exercises browser metadata probes without downloading the body.",
      "path": "/ipns/ipfs.tech/_nuxt/developers-hero.BRuJDQyf.jpg",
      "method": "HEAD",
      "expect_status": 200,
      "expect_content_type_prefix": "image/",
      "expect_content_length_min": 4096,
      "max_ttfb_ms": 45000
    },
    {
      "id": "wikipedia-on-ipfs-root",
      "description": "Small independent DNSLink root outside ipfs.tech. Keeps a non-IPFS-project IPNS/DNSLink target in the mobile-web harness.",
      "path": "/ipns/en.wikipedia-on-ipfs.org",
      "expect_status": 200,
      "expect_content_type_prefix": "text/html",
      "min_bytes": 128,
      "max_ttfb_ms": 30000
    },
    {
      "id": "daicowtf-dot-eth-is-not-ipns",
      "description": "Control case: .eth names are resolved by the app ENS layer, not by the IPFS gateway IPNS resolver.",
      "path": "/ipns/daicowtf.eth/",
      "expect_status": 404,
      "expect_content_type_prefix": "text/html",
      "expect_body_contains": "name not found",
      "max_ttfb_ms": 5000
    }
  ]
}
